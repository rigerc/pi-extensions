    assert.equal(config?.apiKey, "custom-key");
    assert.equal(config?.keyOrigin, "$PI_JEV_API_KEY");
    assert.equal(config?.baseURL, "https://openrouter.ai/api");
    assert.equal(config?.model, "typesafe/jev-1.13");
