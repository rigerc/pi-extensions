{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc -b packages/pi-jev",
    "check:pi-jev": "npm --prefix packages/pi-jev run typecheck",
    "test": "vitest run",
    "test:pi-jev": "npm --prefix packages/pi-jev test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run check",
    "publish": "npm run prepublishOnly && npm publish --workspaces --access public",
    "publish:dry": "npm pack --workspaces --dry-run"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
