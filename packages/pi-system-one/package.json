{
  "name": "@rigerc/pi-system-one",
  "version": "0.7.0",
  "description": "Semantic routing and typed System One classifier decisions for Pi, through pi's classifier API",
  "type": "module",
  "main": "extensions/index.ts",
  "bin": {
    "pi-system-one-gate": "./bin/system-one-gate.js",
    "system-one-gate": "./bin/system-one-gate.js",
    "pi-jev-gate": "./bin/system-one-gate.js",
    "jev-gate": "./bin/system-one-gate.js"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "typesafe",
    "openrouter",
    "llama-cpp",
    "local-ai",
    "jev",
    "system-one",
    "tool-router"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "bin",
    "extensions",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "eval:shortlist": "tsx scripts/shortlist-eval.ts",
    "smoke": "pi -ne -e builtin:llama.cpp -e ./extensions/index.ts -p --no-session \"list loaded tools\""
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0 <1.0.0",
    "@earendil-works/pi-tui": ">=0.99.0 <1.0.0",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/node": "^26.6.3",
    "@sinclair/typebox": "^0.34.28",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rigerc/pi-extensions.git",
    "directory": "packages/pi-system-one"
  },
  "bugs": {
    "url": "https://github.com/rigerc/pi-extensions/issues"
  },
  "homepage": "https://github.com/rigerc/pi-extensions/tree/master/packages/pi-system-one#readme",
  "author": "Theophilo Damiao",
  "contributors": [
    "rigerc"
  ],
  "license": "MIT"
}
