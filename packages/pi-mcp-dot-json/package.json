{
  "name": "@rigerc/pi-mcp-dot-json",
  "version": "0.1.0",
  "description": "Pi extension that registers the MCP servers of a project's .mcp.json, next to the ones from pi's mcp.json",
  "type": "module",
  "main": "extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "mcp.json",
    "model-context-protocol"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0 <1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^26.6.3",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rigerc/pi-extensions.git",
    "directory": "packages/pi-mcp-dot-json"
  },
  "bugs": {
    "url": "https://github.com/rigerc/pi-extensions/issues"
  },
  "homepage": "https://github.com/rigerc/pi-extensions/tree/master/packages/pi-mcp-dot-json#readme",
  "author": "Theophilo Damiao",
  "contributors": [
    "rigerc"
  ],
  "license": "MIT"
}
